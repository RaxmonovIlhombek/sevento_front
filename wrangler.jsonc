{
  // Cloudflare (Workers Builds) uchun: dist/ papkasini statik sayt sifatida chiqaradi.
  // Build: npm ci && npm run build   |   Deploy: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sevento",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    // SPA: noma'lum yo'llar (masalan /sales/12) index.html ga qaytariladi
    "not_found_handling": "single-page-application"
  }
}
